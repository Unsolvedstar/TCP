{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Metro already resolves `signature-pad` to signature-pad.native.tsx or
    // .web.tsx per platform at bundle time; tsc needs its own hint to do the
    // same instead of erroring that a bare `signature-pad` file doesn't
    // exist. Both variants export the same shape, so either resolution
    // order type-checks identically for callers.
    "moduleSuffixes": [".native", ".web", ""]
  }
}
