# Copy this file to .env and fill in your own Supabase project's values.
# Find them in your Supabase dashboard: Project Settings > API.
#
# These are safe to ship in the app bundle — the "anon" key only ever grants what
# the Row Level Security policies in supabase/migrations/0001_init.sql allow.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
